{
  "format": 1,
  "title": "Image classifier hyperparameter study",
  "notes": "ResNet-18 trained from scratch for 30 epochs on a 100-class image set (120 000 training images, 10 000 validation images) on the shared GPU cluster. A 48-run Latin hypercube covers learning rate (entered as log10, e.g. −3 = 0.001), batch size, dropout and optimizer; each run is one training job with a fixed random seed. The scheduler assigns each job to whichever GPU node type is free, and the shared storage throughput (mean read rate logged by the data loader) varies with cluster load over the day; both are recorded as environmental factors. Jobs whose loss became NaN were stopped and are excluded. Goal: highest validation top-1 accuracy at a reasonable training time.",
  "factors": [
    {
      "id": 1,
      "symbol": "A",
      "name": "Learning rate",
      "units": "log10",
      "kind": {
        "type": "continuous",
        "low": -4.5,
        "high": -1.0
      },
      "role": "controlled"
    },
    {
      "id": 2,
      "symbol": "B",
      "name": "Batch size",
      "units": "",
      "kind": {
        "type": "discrete",
        "levels": [
          16.0,
          32.0,
          64.0,
          128.0
        ]
      },
      "role": "controlled"
    },
    {
      "id": 3,
      "symbol": "C",
      "name": "Dropout",
      "units": "",
      "kind": {
        "type": "continuous",
        "low": 0.0,
        "high": 0.5
      },
      "role": "controlled"
    },
    {
      "id": 4,
      "symbol": "D",
      "name": "Optimizer",
      "units": "",
      "kind": {
        "type": "categorical",
        "levels": [
          "AdamW",
          "SGD",
          "RMSprop"
        ]
      },
      "role": "controlled"
    },
    {
      "id": 5,
      "symbol": "E",
      "name": "GPU node",
      "units": "",
      "kind": {
        "type": "categorical",
        "levels": [
          "A100",
          "V100",
          "L4"
        ]
      },
      "role": "environmental"
    },
    {
      "id": 6,
      "symbol": "F",
      "name": "Storage throughput",
      "units": "GB/s",
      "kind": {
        "type": "continuous",
        "low": 0.3,
        "high": 2.5
      },
      "role": "environmental"
    }
  ],
  "responses": [
    {
      "id": 7,
      "name": "Validation accuracy",
      "units": "%",
      "goal": "maximize",
      "lower": 70.0,
      "target": null,
      "upper": 80.0,
      "weight": 1.0,
      "importance": 4.0
    },
    {
      "id": 8,
      "name": "Training time",
      "units": "min",
      "goal": "minimize",
      "lower": 25.0,
      "target": null,
      "upper": 120.0,
      "weight": 1.0,
      "importance": 2.0
    }
  ],
