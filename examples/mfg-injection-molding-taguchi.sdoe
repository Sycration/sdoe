{
  "format": 1,
  "title": "Injection moulding of a PA6 connector housing: robust parameter design",
  "notes": "Robust parameter study for an unfilled PA6 connector housing on a 110 t machine with a 2-cavity hot-runner mould. Four machine settings are varied on three levels in an L9 inner array. Each setting is run with two resin lots and at two conditioning humidities (outer array), because both vary in production and cannot be held constant. Five parts per condition are collected after the process has stabilised; the recorded values are the averages. Shrinkage is measured on the 40 mm length after 24 h conditioning (target 1.20 %), weight on a 0.01 g balance and warpage as flatness deviation on the CMM. Use Analysis > Robustness with the nominal-the-best signal-to-noise ratio for shrinkage and smaller-the-better for warpage.",
  "factors": [
    {
      "id": 1,
      "symbol": "A",
      "name": "Melt temperature",
      "units": "°C",
      "kind": {
        "type": "continuous",
        "low": 230.0,
        "high": 270.0
      },
      "role": "controlled"
    },
    {
      "id": 2,
      "symbol": "B",
      "name": "Hold pressure",
      "units": "bar",
      "kind": {
        "type": "continuous",
        "low": 400.0,
        "high": 700.0
      },
      "role": "controlled"
    },
    {
      "id": 3,
      "symbol": "C",
      "name": "Cooling time",
      "units": "s",
      "kind": {
        "type": "continuous",
        "low": 8.0,
        "high": 16.0
      },
      "role": "controlled"
    },
    {
      "id": 4,
      "symbol": "D",
      "name": "Mould temperature",
      "units": "°C",
      "kind": {
        "type": "continuous",
        "low": 50.0,
        "high": 90.0
      },
      "role": "controlled"
    },
    {
      "id": 5,
