{
  "format": 1,
  "title": "Spray drying of a Lactobacillus probiotic powder (planned)",
  "notes": "Planned study on a laboratory spray dryer (two-fluid nozzle, co-current) for a Lactobacillus rhamnosus concentrate in a skim milk / maltodextrin carrier. Inlet temperature, feed rate, atomising air flow and carrier solids follow a Box-Behnken design in randomized order. The absolute humidity of the inlet air depends on the weather and is to be recorded at the start of each run. Viability loss is log10(CFU/g dry matter before drying) minus log10(CFU/g after drying), plated on MRS agar; moisture by Karl Fischer; yield as powder collected in the cyclone relative to solids fed.",
  "factors": [
    {
      "id": 1,
      "symbol": "A",
      "name": "Inlet temperature",
      "units": "°C",
      "kind": {
        "type": "continuous",
        "low": 130.0,
        "high": 170.0
      },
      "role": "controlled"
    },
    {
      "id": 2,
      "symbol": "B",
      "name": "Feed rate",
      "units": "mL/min",
      "kind": {
        "type": "continuous",
        "low": 4.0,
        "high": 10.0
      },
      "role": "controlled"
    },
    {
      "id": 3,
      "symbol": "C",
      "name": "Atomising air flow",
      "units": "L/h",
      "kind": {
        "type": "continuous",
        "low": 400.0,
        "high": 600.0
      },
      "role": "controlled"
    },
    {
      "id": 4,
      "symbol": "D",
      "name": "Carrier solids",
      "units": "% w/w",
      "kind": {
        "type": "continuous",
        "low": 15.0,
        "high": 30.0
      },
      "role": "controlled"
    },
    {
      "id": 5,
      "symbol": "E",
      "name": "Inlet air absolute humidity",
      "units": "g/kg",
      "kind": {
        "type": "continuous",
        "low": 4.0,
        "high": 14.0
      },
      "role": "environmental"
    }
  ],
  "responses": [
