      "id": 1,
      "symbol": "A",
      "name": "Catalyst",
      "units": "",
      "kind": {
        "type": "categorical",
        "levels": [
          "Pd/C",
          "Pt/C"
        ]
      },
      "role": "controlled"
    },
    {
      "id": 2,
      "symbol": "B",
      "name": "Solvent",
