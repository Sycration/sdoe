  "mixture_total": 1.0,
  "design": {
    "method": "Fractional factorial (2-level)",
    "notes": [
      "2^(7-3) fraction, 16 runs, resolution IV.",
      "Generators: E = ABC, F = ABD, G = ACD",
      "Defining relation: I = ABCE = ABDF = CDEF = ACDG = BDEG = BCFG = AEFG",
      "Alias structure (up to three-factor interactions):",
      "  A + BCE + BDF + CDG + EFG",
      "  B + ACE + ADF + DEG + CFG",
      "  C + ABE + DEF + ADG + BFG",
      "  D + ABF + CEF + ACG + BEG",
      "  E + ABC + CDF + BDG + AFG",
      "  F + ABD + CDE + BCG + AEG",
      "  G + ACD + BDE + BCF + AEF",
      "  AB + CE + DF",
      "  AC + BE + DG",
      "  AD + BF + CG",
      "  AE + BC + FG",
      "  AF + BD + EG",
      "  AG + CD + EF",
      "  BG + DE + CF"
    ],
