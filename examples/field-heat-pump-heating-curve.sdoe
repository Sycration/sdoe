{
  "format": 1,
  "title": "Office heat pump: supply temperature and fan-coil study",
  "notes": "Two-storey office (about 900 m², 24 fan-coil units) heated by an air-to-water heat pump. Over eight working weeks (5 January to 27 February 2026) the building management system applied one combination of supply water temperature, fan-coil speed and preheat start per working day. The settings were planned as an optimal design around the day-ahead forecast of the daily mean outdoor temperature; the run notes give the date and the forecast, the Outdoor temperature column holds the measured daily mean. Solar irradiation is the measured daily global horizontal total. Electricity covers the heat pump, the fan coils and the circulation pumps (sub-meter). Discomfort is the sum of degree-hours below 20.5 °C over all zone sensors during occupancy (07:00–18:00), averaged over zones. Goal: a heating curve (supply temperature as a function of outdoor temperature) and fan speed that keep discomfort low at the lowest electricity use.",
  "factors": [
    {
      "id": 1,
      "symbol": "A",
      "name": "Supply temperature",
      "units": "°C",
      "kind": {
        "type": "continuous",
        "low": 30.0,
        "high": 50.0
      },
      "role": "controlled"
    },
    {
      "id": 2,
      "symbol": "B",
      "name": "Fan speed",
      "units": "%",
      "kind": {
        "type": "continuous",
        "low": 30.0,
        "high": 100.0
      },
      "role": "controlled"
    },
    {
      "id": 3,
      "symbol": "C",
      "name": "Preheat start",
      "units": "h",
      "kind": {
        "type": "continuous",
        "low": 0.5,
        "high": 3.5
      },
      "role": "controlled"
    },
    {
      "id": 4,
      "symbol": "D",
      "name": "Outdoor temperature",
      "units": "°C",
      "kind": {
        "type": "continuous",
        "low": -10.0,
        "high": 12.0
      },
      "role": "environmental"
    },
    {
      "id": 5,
      "symbol": "E",
      "name": "Solar irradiation",
      "units": "kWh/m²",
      "kind": {
        "type": "continuous",
        "low": 0.2,
        "high": 3.5
      },
      "role": "environmental"
    }
  ],
  "responses": [
    {
      "id": 6,
      "name": "Electricity",
      "units": "kWh",
      "goal": "minimize",
      "lower": 50.0,
      "target": null,
      "upper": 250.0,
      "weight": 1.0,
      "importance": 3.0
    },
    {
      "id": 7,
      "name": "Discomfort",
      "units": "K·h",
      "goal": "minimize",
      "lower": 0.0,
      "target": null,
      "upper": 6.0,
      "weight": 1.0,
      "importance": 4.0
    }
  ],
