{
  "format": 1,
  "title": "Pricing page multivariate test (planned)",
  "notes": "Time-sliced test of the SaaS pricing page: the content system serves a single page version to all visitors on a given day, so each run is one calendar day with one combination of headline, button colour and price display. Full factorial (12 combinations) in 3 replicates over 36 days in random order. For each day, record the weekday and the share of visitors from paid campaigns (web analytics), then the conversion rate (trial sign-ups per visitor) and revenue per visitor after 30 days.",
  "factors": [
    {
      "id": 1,
      "symbol": "A",
      "name": "Headline",
      "units": "",
      "kind": {
        "type": "categorical",
        "levels": [
          "Benefit",
          "Question",
          "Social proof"
        ]
      },
      "role": "controlled"
    },
    {
      "id": 2,
      "symbol": "B",
      "name": "Button colour",
      "units": "",
      "kind": {
        "type": "categorical",
        "levels": [
          "Green",
          "Orange"
        ]
      },
      "role": "controlled"
    },
    {
